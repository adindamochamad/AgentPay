# Basis data (async untuk aplikasi; Alembic memakai driver sinkron lewat URL yang disetar).
#
# Di dalam container backend (docker compose): hostname layanan = postgres, redis.
# Di laptop Anda (uvicorn lokal): pakai localhost setelah `docker compose up -d postgres`
# (port 5432 terbuka ke host).
#
# Contoh lokal:
# DATABASE_URL=postgresql+asyncpg://agentpay:agentpay_secret@localhost:5432/agentpay
DATABASE_URL=postgresql+asyncpg://agentpay:agentpay_secret@postgres:5432/agentpay
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
DATABASE_ECHO=false
DATABASE_POOL_RECYCLE=3600

# Basis data pengujian (opsional — pytest memakai SQLite jika kosong)
# Lokal: ganti postgres → localhost seperti DATABASE_URL.
TEST_DATABASE_URL=postgresql+asyncpg://agentpay:agentpay_secret@postgres:5432/agentpay_test

# Lokal: redis://localhost:6379/0
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50

API_V1_PREFIX=/api/v1
PROJECT_NAME=AgentPay
VERSION=0.1.0
CORS_ORIGINS='["http://localhost:3000","http://localhost:8000","http://localhost:5173"]'

SECRET_KEY=dev-secret-change-in-production-use-openssl-rand-hex-32
SIGNATURE_MAX_AGE_SECONDS=300
SIGNATURE_MAX_FUTURE_SKEW_SECONDS=60

ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Di container backend (Compose): path ke logging JSON — lihat backend/docker/logging.conf
# LOGGING_CONF_PATH=/app/docker/logging.conf
TESTING=false

MAX_TRANSACTIONS_PER_HOUR=100
TRANSACTION_TIMEOUT_HOURS=1
MIN_TRANSACTION_AMOUNT=0.00000001
MAX_TRANSACTION_AMOUNT=1000000

ENABLE_BACKGROUND_TASKS=true
DISPUTE_LOG_PATH=dispute_review.log

# Hostname Postgres untuk skrip entrypoint (tunggu pg_isready).
POSTGRES_HOST=postgres

# Seed agen demo alice/bob setelah migrasi (1/true = aktif; di production diabaikan).
SEED_DEMO=0
