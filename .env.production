# === Template lingkungan produksi AgentPay ===
# Salin ke penyimpanan secrets terkelola (bukan ke repositori git).
# Peringatan: jangan commit berkas .env berisi rahasia.

# --- Basis data ---
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@host-intern:5432/agentpay
# TEST_DATABASE_URL= (biasanya kosong di produksi)

# --- Redis ---
# REDIS_URL=redis://:PASSWORD@redis-intern:6379/0

# --- Aplikasi ---
# ENVIRONMENT=production
# DEBUG=false
# LOG_LEVEL=WARNING
# SECRET_KEY=<openssl rand -hex 32>
# CORS_ORIGINS=["https://app.domain-anda.com"]

# --- Timeout & bisnis ---
# TRANSACTION_TIMEOUT_HOURS=24
# MAX_TRANSACTIONS_PER_HOUR=500

# --- Opsional Docker ---
# POSTGRES_HOST=postgres
# SEED_DEMO=0
# DISPUTE_LOG_PATH=/tmp/dispute_review.log
